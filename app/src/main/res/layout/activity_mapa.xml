<?xml version="1.0" encoding="utf-8"?>

<!-- Layout principal: RelativeLayout permite posicionar elementos relativos entre sí -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Barra superior que contiene únicamente los botones de cambio de modo -->
    <LinearLayout
        android:id="@+id/layout_modos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#0B132B"
        android:elevation="6dp">

        <!-- Botón para mostrar todos los aviones -->
        <Button
            android:id="@+id/btn_todos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#1C2541"
            android:textColor="#FFFFFF"
            android:text="@string/todos" />

        <!-- Botón para mostrar solo los avistados -->
        <Button
            android:id="@+id/btn_avistados"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#1C2541"
            android:textColor="#FFFFFF"
            android:text="@string/avistados" />
    </LinearLayout>

    <!-- Fragmento para el mapa de Google Maps -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_modos" />

    <!-- Botón flotante hacia atrás alineado a la izquierda a la misma altura que el de ubicación -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_volver_mapa"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_below="@id/layout_modos"
        android:layout_alignParentStart="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#D9FFFFFF"
        app:cardCornerRadius="2dp"
        app:cardElevation="3dp">

        <ImageButton
            android:id="@+id/btn_volver_mapa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_volver_atras"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#555555" />
    </androidx.cardview.widget.CardView>

    <!-- Panel inferior tipo CardView para mostrar información del avión seleccionado -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_info_vuelo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#1C2541">

        <!-- Contenedor vertical para organizar los elementos dentro del CardView -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Fila con el título del panel y el icono de información en la esquina derecha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- TextView que muestra el modelo y fabricante del avión -->
                <TextView
                    android:id="@+id/txt_modelo_panel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/modelo"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <!-- Icono informativo sin lógica propia: al tocar el panel (también aquí) se abre la ficha completa -->
                <ImageView
                    android:id="@+id/img_info_panel"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_info_panel"
                    android:clickable="false"
                    android:focusable="false"
                    android:contentDescription="@string/cd_ver_ficha_completa" />
            </LinearLayout>

            <!-- Línea divisoria horizontal entre modelo y datos -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#3A506B" />

            <!-- TextView que muestra datos del vuelo como ICAO, país, velocidad y altitud -->
            <TextView
                android:id="@+id/txt_datos_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/datos_del_vuelo"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="#B0BEC5" />

            <!-- Botón para marcar como avistado el avión seleccionado -->
            <Button
                android:id="@+id/btn_avistar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#00E5FF"
                android:textColor="#0B132B"
                android:textStyle="bold"
                android:text="@string/avistar_este_avi_n" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>