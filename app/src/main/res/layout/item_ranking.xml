<?xml version="1.0" encoding="utf-8"?>

<!-- Tarjeta horizontal de cada piloto en la clasificación global -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardItemRanking"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#151E32"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:strokeColor="#26324B"
    app:strokeWidth="1dp">

    <!-- Fila horizontal principal que organiza posición, avatar, datos del piloto y puntuación -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Puesto numérico (#1, #2, #3...) coloreado dinámicamente en oro, plata, bronce o cian -->
        <TextView
            android:id="@+id/txtPosicionRanking"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#00E5FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Contenedor circular con recorte de esquinas para la fotografía de perfil del piloto -->
        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="#0B1021"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <!-- Imagen de avatar del piloto cargada con Glide o icono por defecto -->
            <ImageView
                android:id="@+id/imgAvatarRanking"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_foto_perfil"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_myplaces" />
        </androidx.cardview.widget.CardView>

        <!-- Bloque central flexible que apila el nombre público y el contador de avistamientos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nombre público del piloto truncado con puntos suspensivos si excede una línea -->
            <TextView
                android:id="@+id/txtNombreRanking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Subtítulo informativo con el total de aviones verificados del piloto -->
            <TextView
                android:id="@+id/txtAvistadosRanking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#90A4AE"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Insignia derecha con la puntuación total acumulada del piloto -->
        <TextView
            android:id="@+id/txtPuntosRanking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#0B1021"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>