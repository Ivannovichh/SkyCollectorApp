<?xml version="1.0" encoding="utf-8"?>

<!-- Pantalla de perfil público de un piloto y su colección de avistamientos -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1021"
    android:orientation="vertical">

    <!-- Barra superior con botón de retroceso -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#151E32"
        android:elevation="6dp"
        android:padding="14dp">

        <ImageButton
            android:id="@+id/btnVolverPerfilPublico"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_volver_atras"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#00E5FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/titulo_hangar_piloto"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Tarjeta superior con avatar, nombre de usuario y resumen de puntos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#10172A"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp">

        <androidx.cardview.widget.CardView
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#151E32"
            app:cardCornerRadius="43dp"
            app:cardElevation="6dp">

            <ImageView
                android:id="@+id/imgAvatarPerfilPublico"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_foto_perfil"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_myplaces" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txtNombrePerfilPublico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtEstadisticasPerfilPublico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Cuadrícula de aviones avistados por este usuario -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAvionesPublicos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <ProgressBar
            android:id="@+id/progressPerfilPublico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#00E5FF" />

        <TextView
            android:id="@+id/txtHangarPublicoVacio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/hangar_publico_vacio"
            android:textColor="#B0BEC5"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>