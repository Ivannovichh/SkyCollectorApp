<?xml version="1.0" encoding="utf-8"?>

<!-- Tarjeta flotante con bordes redondeados y el fondo azul oscuro secundario de la app -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="#151E32"
    app:cardCornerRadius="18dp"
    app:cardElevation="10dp">

    <!-- Contenedor vertical centrado para los elementos del diálogo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Icono decorativo superior con tinte cian -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/cd_icono_piloto"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#00E5FF" />

        <!-- Título principal de la ventana emergente -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/dialogo_elegir_nombre_titulo"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Texto explicativo que aclara la privacidad frente al ranking público -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="@string/dialogo_elegir_nombre_mensaje"
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <!-- Campo de texto para escribir el apodo público del jugador -->
        <EditText
            android:id="@+id/etNuevoNombreUsuario"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="20dp"
            android:background="#0B1021"
            android:hint="@string/hint_ejemplo_piloto"
            android:inputType="textPersonName"
            android:maxLength="20"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#90A4AE" />

        <!-- Botón cian para guardar el apodo y cerrar la ventana -->
        <Button
            android:id="@+id/btnGuardarNombreInicial"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#00E5FF"
            android:text="@string/btn_confirmar_nombre"
            android:textColor="#0B1021"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>