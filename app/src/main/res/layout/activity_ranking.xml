<?xml version="1.0" encoding="utf-8"?>

<!-- Contenedor principal vertical con fondo azul noche -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1021"
    android:orientation="vertical">

    <!-- Cabecera superior con botón de retroceso y título -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#151E32"
        android:elevation="6dp"
        android:padding="14dp">

        <ImageButton
            android:id="@+id/btnVolverRanking"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_volver_atras"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#00E5FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/titulo_ranking_pilotos"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Barra informativa con el baremo de puntos por rareza -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#10172A"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@string/leyenda_puntos_rareza"
        android:textColor="#90A4AE"
        android:textSize="11sp" />

    <!-- Contenedor central con indicador de carga, estado vacío y lista -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRanking"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp" />

        <ProgressBar
            android:id="@+id/progressRanking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#00E5FF" />

        <TextView
            android:id="@+id/txtRankingVacio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/ranking_sin_pilotos"
            android:textColor="#B0BEC5"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Tarjeta fija inferior con la posición exacta del usuario actual -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMiPosicionRanking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#151E32"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:strokeColor="#00E5FF"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/txtMiPosicionRanking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:text="#—"
                android:textColor="#00E5FF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgMiAvatarRanking"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/cd_avatar_piloto"
                android:src="@android:drawable/ic_menu_myplaces" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtMiNombreRanking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMisAvistadosRanking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#90A4AE"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtMisPuntosRanking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#00E5FF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>