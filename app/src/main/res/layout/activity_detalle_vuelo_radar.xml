<?xml version="1.0" encoding="utf-8"?> <!-- Declaración estándar XML -->

<!-- Contenedor principal con fondo azul noche corporativo -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B132B">

    <!-- Barra superior con botón de retroceso y título -->
    <LinearLayout
        android:id="@+id/header_detalle_radar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C2541"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Botón de flecha hacia atrás -->
        <ImageButton
            android:id="@+id/btn_volver_detalle_radar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver al mapa"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#00E5FF" />

        <!-- Título de la pantalla -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Ficha de Aeronave en Radar"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenedor inferior fijo con el único botón de avistar -->
    <LinearLayout
        android:id="@+id/footer_avistar_radar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1C2541"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Indicador de distancia respecto al límite de 30 km -->
        <TextView
            android:id="@+id/txt_estado_distancia_detalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <!-- Botón principal de acción en cian -->
        <Button
            android:id="@+id/btn_avistar_desde_detalle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#00E5FF"
            android:text="@string/avistar_este_avi_n"
            android:textColor="#0B132B"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenido desplazable con la carta coleccionable y especificaciones -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/footer_avistar_radar"
        android:layout_below="@id/header_detalle_radar"
        android:clipToPadding="false"
        android:padding="16dp">

        <!-- Carta central del avión -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1C2541"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Cabecera de la carta: Etiqueta de rareza y código ICAO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_rareza_detalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#3A506B"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="COMMON"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/txt_icao_badge_detalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ICAO: ---"
                        android:textColor="#00E5FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Contenedor de la fotografía de catálogo de la aeronave -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#0B132B"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/img_avion_detalle_radar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Imagen del modelo de avión"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sil_jet" />
                </androidx.cardview.widget.CardView>

                <!-- Nombre del modelo de aeronave -->
                <TextView
                    android:id="@+id/txt_modelo_detalle_radar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Modelo de Aeronave"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Aerolínea o fabricante -->
                <TextView
                    android:id="@+id/txt_empresa_detalle_radar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Fabricante / Aerolínea"
                    android:textColor="#B0BEC5"
                    android:textSize="15sp" />

                <!-- Separador visual -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#3A506B" />

                <!-- Sección de telemetría en vivo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DATOS DEL VUELO EN VIVO"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_telemetria_detalle_radar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <!-- Separador visual -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#3A506B" />

                <!-- Sección de ficha técnica de catálogo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ESPECIFICACIONES TÉCNICAS"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_specs_detalle_radar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

</RelativeLayout>