<?xml version="1.0" encoding="utf-8"?>

<!-- Contenedor con scroll vertical para asegurar accesibilidad en pantallas pequeñas -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1021"
    android:fillViewport="true">

    <!-- Contenedor vertical principal de la pantalla de perfil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Cabecera horizontal con botón de retroceso y título de la pantalla -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Botón de flecha hacia atrás para regresar al menú principal -->
            <ImageButton
                android:id="@+id/btnVolverPerfil"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_volver"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#00E5FF" />

            <!-- Título de la pantalla de perfil -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/titulo_perfil_piloto"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tarjeta circular contenedora de la fotografía de perfil -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFotoPerfil"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#151E32"
            app:cardCornerRadius="55dp"
            app:cardElevation="6dp">

            <!-- Vista de imagen para mostrar el avatar del piloto -->
            <ImageView
                android:id="@+id/imgFotoPerfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_foto_perfil"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_myplaces" />
        </androidx.cardview.widget.CardView>

        <!-- Texto indicativo bajo la foto de perfil -->
        <TextView
            android:id="@+id/txtCambiarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/toca_cambiar_foto"
            android:textColor="#00E5FF"
            android:textSize="13sp" />

        <!-- Tarjeta contenedora de los campos editables de identidad y contacto -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#151E32"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <!-- Contenedor vertical interno para los campos de texto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Etiqueta del nombre de usuario público -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/label_nombre_usuario_publico"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Campo editable para el indicativo público del piloto -->
                <EditText
                    android:id="@+id/etNombrePerfil"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="#0B1021"
                    android:hint="@string/hint_nombre_usuario"
                    android:inputType="textPersonName"
                    android:maxLength="20"
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#90A4AE" />

                <!-- Etiqueta del correo electrónico privado -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/label_correo_privado"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Campo editable para visualizar o añadir el correo electrónico -->
                <EditText
                    android:id="@+id/etCorreoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="#0B1021"
                    android:hint="@string/hint_anadir_correo"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#90A4AE" />

                <!-- Etiqueta del número de teléfono privado -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/label_telefono_privado"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Campo editable para visualizar o añadir el teléfono de contacto -->
                <EditText
                    android:id="@+id/etTelefonoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="#0B1021"
                    android:hint="@string/hint_anadir_telefono"
                    android:inputType="phone"
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#90A4AE" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botón principal para guardar todos los cambios del perfil -->
        <Button
            android:id="@+id/btnGuardarPerfil"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#00E5FF"
            android:text="@string/guardar_cambios"
            android:textColor="#0B1021"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Botón rojo para cerrar la sesión actual en Firebase -->
        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#D32F2F"
            android:text="@string/cerrar_sesion"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>